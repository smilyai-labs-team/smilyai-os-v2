[Unit]
Description=SmilyAI graphical shell
Wants=smilyai-ui.service
After=smilyai-ui.service
PartOf=graphical-session.target
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=exec
ExecStart=/usr/local/bin/smilyai-shell
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=64 69 77 78
TimeoutStopSec=15
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smilyai-shell
